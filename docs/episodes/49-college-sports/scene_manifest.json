          "scene_time_s": 15.9,
          "absolute_s": 507.97
        },
        {
          "param": "items[2].at.cue",
          "cue": "The line between",
          "label": "items[2].at.cue",
          "scene_time_s": 15.9,
          "absolute_s": 507.97
