    {
      "index": 36,
      "id": "s35_congress",
      "segment": "m5_congress",
      "type": "engine_cartoon",
      "start_s": 572.57,
      "end_s": 608.67,
      "duration_s": 36.1,
      "visual_objective": "",
      "narration": "Washington is trying to write the rules. In April twenty twenty-six, the President signed an executive order asking for revenue sharing that preserves or expands women's and Olympic sports. Its main sections took effect in August. An executive order can push the schools, but it cannot rewrite the settlement or the labor laws on its own. In September, the Senate passed a bill called the Protect College Sports Act, seventy-seven to twenty-two. The House has not voted on it, so it is not law.",
      "keyframes": [
        {
          "param": "items[1].at.cue",
          "cue": "signed an executive order",
          "label": "items[1].at.cue",
          "scene_time_s": 6.53,
          "absolute_s": 579.09
        },
        {
          "param": "cam[1].at.cue",
          "cue": "In September",
          "label": "cam[1].at.cue",
          "scene_time_s": 24.62,
          "absolute_s": 597.19
        },
        {
          "param": "items[2].at.cue",
