    {
      "index": 35,
      "id": "s34_johnson",
      "segment": "m5_johnson",
      "type": "engine_cartoon",
      "start_s": 547.5,
      "end_s": 572.57,
      "duration_s": 25.07,
      "visual_objective": "",
      "narration": "In twenty twenty-four, a federal appeals court ruled in a case called Johnson versus the NCAA. It said athletes cannot be barred from claiming wages just because they are called amateurs. Courts must look at the economic reality of what they do. The court sent the case back to a lower court to do exactly that, and the question is still open.",
      "keyframes": [
        {
          "param": "items[3].hits[0].cue",
          "cue": "a federal appeals court ruled",
          "label": "items[3].hits[0].cue",
          "scene_time_s": 2.07,
          "absolute_s": 549.57
        },
        {
          "param": "items[1].at.cue",
          "cue": "cannot be barred",
          "label": "items[1].at.cue",
          "scene_time_s": 9.15,
          "absolute_s": 556.65
        },
        {
          "param": "cam[1].at.cue",
          "cue": "The court sent the case back",
          "label": "cam[1].at.cue",
          "scene_time_s": 18.56,
          "absolute_s": 566.06
        },
        {
          "param": "items[2].at.cue",
          "cue": "The court sent the case back",
          "label": "items[2].at.cue",
          "scene_time_s": 18.56,
          "absolute_s": 566.06
        }
      ],
      "unresolved_cues": [],
      "assets": [
