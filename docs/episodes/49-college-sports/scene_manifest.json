      "type": "engine_cartoon",
      "start_s": 227.47,
      "end_s": 246.53,
      "duration_s": 19.07,
      "visual_objective": "",
      "narration": "Not every school went all in. Of the three hundred and nineteen schools that opted into the system, sixty-eight hit the cap or came within five percent of it. Most schools in the system paid less than the maximum, because most schools simply do not have that kind of money.",
      "keyframes": [
        {
          "param": "items[1].at.cue",
          "cue": "three hundred and nineteen",
          "label": "items[1].at.cue",
          "scene_time_s": 3.81,
          "absolute_s": 231.27
        },
        {
          "param": "items[2].at.cue",
