          "label": "items[2].at.cue",
          "scene_time_s": 7.68,
          "absolute_s": 235.14
        },
        {
          "param": "cam[1].at.cue",
          "cue": "Most schools in the system",
          "label": "cam[1].at.cue",
          "scene_time_s": 11.66,
          "absolute_s": 239.13
