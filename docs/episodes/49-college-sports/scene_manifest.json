          "label": "actions[0].at.cue",
          "scene_time_s": 13.84,
          "absolute_s": 160.11
        },
        {
          "param": "strokes[2].start.cue",
          "cue": "The rest still has to pay",
          "label": "strokes[2].start.cue",
          "scene_time_s": 16.28,
          "absolute_s": 162.55
        }
      ],
      "unresolved_cues": [],
