      "type": "engine_cartoon",
      "start_s": 322.97,
      "end_s": 356.63,
      "duration_s": 33.67,
      "visual_objective": "",
      "narration": "The old system limited how many scholarships a team could give. The new one limits how many athletes a team can have at all. Football rosters are capped at one hundred and five. Basketball at fifteen. Baseball at thirty-four. Softball at twenty-five. Golf at nine. The plaintiffs' expert estimated that removing the old scholarship caps could open more than one hundred and fifteen thousand new scholarships across the country, another estimate, not a count.",
      "keyframes": [
        {
          "param": "items[1].at.cue",
          "cue": "Basketball",
          "label": "items[1].at.cue",
          "scene_time_s": 13.72,
          "absolute_s": 336.69
        },
        {
          "param": "cam[1].at.cue",
          "cue": "Softball",
          "label": "cam[1].at.cue",
          "scene_time_s": 17.15,
          "absolute_s": 340.12
        },
        {
          "param": "items[2].at.cue",
          "cue": "Softball",
          "label": "items[2].at.cue",
          "scene_time_s": 17.15,
          "absolute_s": 340.12
        },
        {
          "param": "items[3].at.cue",
          "cue": "The plaintiffs' expert",
          "label": "items[3].at.cue",
          "scene_time_s": 21.15,
          "absolute_s": 344.12
        }
      ],
      "unresolved_cues": [],
      "assets": [
