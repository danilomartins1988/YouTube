          "label": "strokes[0].start.cue",
          "scene_time_s": 3.15,
          "absolute_s": 611.82
        },
        {
          "param": "strokes[1].start.cue",
          "cue": "The other says employee",
          "label": "strokes[1].start.cue",
          "scene_time_s": 7.56,
          "absolute_s": 616.23
