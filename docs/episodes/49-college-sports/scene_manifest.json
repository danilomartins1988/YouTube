          "scene_time_s": 24.62,
          "absolute_s": 597.19
        },
        {
          "param": "items[3].at.cue",
          "cue": "so it is not law",
          "label": "items[3].at.cue",
          "scene_time_s": 34.47,
          "absolute_s": 607.04
        }
      ],
      "unresolved_cues": [],
      "assets": [
        "font:inter"
