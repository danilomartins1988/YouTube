        {
          "param": "cam[1].at.cue",
          "cue": "The university said",
          "label": "cam[1].at.cue",
          "scene_time_s": 9.49,
          "absolute_s": 387.46
        },
        {
          "param": "items[2].at.cue",
          "cue": "The university said",
          "label": "items[2].at.cue",
          "scene_time_s": 9.49,
