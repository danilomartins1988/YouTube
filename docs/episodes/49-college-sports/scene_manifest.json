      "duration_s": 20.03,
      "visual_objective": "",
      "narration": "Let me draw the two doors. One door says student, with scholarships and classes. The other says employee, with wages and contracts. Today's athletes stand in the hallway between them, with a payroll in one hand and a student ID in the other.",
      "keyframes": [
        {
          "param": "draw_start.cue",
          "cue": "One door says student",
          "label": "draw_start.cue",
          "scene_time_s": 3.15,
          "absolute_s": 611.82
        },
        {
          "param": "strokes[0].start.cue",
