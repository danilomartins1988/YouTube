      "type": "engine_cartoon",
      "start_s": 206.97,
      "end_s": 227.47,
      "duration_s": 20.5,
      "visual_objective": "",
      "narration": "Counting everything the commission tracks, including scholarships and education awards, payments to athletes reached about one point nine eight billion dollars in that first year. For context, that is about the same as the entire ten-year damages fund for name and image rights, paid out in a single season.",
      "keyframes": [
        {
          "param": "items[0].steps[1][0].cue",
          "cue": "in that first year",
          "label": "items[0].steps[1][0].cue",
          "scene_time_s": 10.05,
          "absolute_s": 217.02
        },
        {
          "param": "cam[1].at.cue",
          "cue": "For context",
          "label": "cam[1].at.cue",
          "scene_time_s": 11.8,
          "absolute_s": 218.77
        },
        {
          "param": "items[1].at.cue",
          "cue": "For context",
          "label": "items[1].at.cue",
          "scene_time_s": 11.8,
          "absolute_s": 218.77
        }
      ],
      "unresolved_cues": [],
