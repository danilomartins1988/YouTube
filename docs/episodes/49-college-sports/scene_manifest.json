    {
      "index": 14,
      "id": "s13_paid",
      "segment": "m2_paid",
      "type": "engine_cartoon",
      "start_s": 187.23,
      "end_s": 206.97,
      "duration_s": 19.73,
      "visual_objective": "",
      "narration": "The College Sports Commission, created to police the new system, reported its first-year results in October twenty twenty-six. Schools paid about one point seven seven billion dollars in revenue sharing, to almost thirty-five thousand athletes, at three hundred and seven schools.",
      "keyframes": [
        {
          "param": "cam[1].at.cue",
          "cue": "Schools paid",
          "label": "cam[1].at.cue",
          "scene_time_s": 9.23,
          "absolute_s": 196.46
        },
        {
          "param": "items[1].at.cue",
          "cue": "Schools paid",
          "label": "items[1].at.cue",
          "scene_time_s": 9.23,
          "absolute_s": 196.46
        },
        {
          "param": "items[1].steps[1][0].cue",
          "cue": "in revenue sharing",
          "label": "items[1].steps[1][0].cue",
          "scene_time_s": 12.75,
          "absolute_s": 199.98
        },
        {
          "param": "items[2].at.cue",
