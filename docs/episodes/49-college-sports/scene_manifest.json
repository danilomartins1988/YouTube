      "end_s": 492.07,
      "duration_s": 19.83,
      "visual_objective": "",
      "narration": "The results are public. Through October twenty twenty-six, more than fifty-six thousand deals were cleared, worth about seven hundred and seventy-five million dollars. And two thousand eight hundred and seventy-seven deals were not cleared, worth about one hundred and seventy-seven million.",
      "keyframes": [
        {
          "param": "items[0].bars[0].at.cue",
