      "end_s": 472.23,
      "duration_s": 22.03,
      "visual_objective": "",
      "narration": "Athletes can still sign deals with outside companies for their name, image and likeness, known as NIL. But now any outside deal worth six hundred dollars or more is reviewed by a clearinghouse called NIL Go. It checks whether the deal has a valid business purpose, and whether the pay is in a reasonable range.",
      "keyframes": [
        {
          "param": "items[0].at.cue",
          "cue": "NIL Go",
          "label": "items[0].at.cue",
