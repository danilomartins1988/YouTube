      ],
      "sources": [],
      "transition_out": "scan"
    },
    {
      "index": 5,
      "id": "s05_c1",
      "segment": "m1_card",
      "type": "act_title",
      "start_s": 51.3,
      "end_s": 56.7,
      "duration_s": 5.4,
      "visual_objective": "Chapter card: masked title reveal, gold rule draws",
      "narration": "",
      "keyframes": [],
