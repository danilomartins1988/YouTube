    },
    {
      "index": 32,
      "id": "s31_c5",
      "segment": "m5_card",
      "type": "act_title",
      "start_s": 541.4,
      "end_s": 546.8,
      "duration_s": 5.4,
      "visual_objective": "Chapter card: masked title reveal, gold rule draws",
