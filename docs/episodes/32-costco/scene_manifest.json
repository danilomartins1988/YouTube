      "type": "engine_cartoon",
      "start_s": 29.73,
      "end_s": 37.73,
      "duration_s": 8.0,
      "visual_objective": "",
      "narration": "So how does a store that sells almost at cost become one of the most powerful retailers in America?",
      "keyframes": [],
      "unresolved_cues": [],
      "assets": [
        "font:inter"
      ],
      "sources": [],
      "transition_out": "scan"
    },
    {
