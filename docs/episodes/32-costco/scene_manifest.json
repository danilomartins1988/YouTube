    {
      "index": 23,
      "id": "s22_kirkland",
      "segment": "m3_kirkland",
      "type": "engine_cartoon",
      "start_s": 374.83,
      "end_s": 402.1,
      "duration_s": 27.27,
      "visual_objective": "",
      "narration": "Then there is Costco's own brand, Kirkland Signature, whose trademark turned thirty in twenty twenty-five. In its latest annual letter, Costco says Kirkland brings in about ninety billion dollars a year worldwide, and typically saves members fifteen to twenty percent compared with the national brand. And according to its annual report, these products generally earn Costco higher margins.",
      "keyframes": [
        {
          "param": "items[1].at.cue",
          "cue": "Kirkland brings in",
          "label": "items[1].at.cue",
          "scene_time_s": 10.87,
          "absolute_s": 385.71
        },
        {
          "param": "items[1].steps[1][0].cue",
          "cue": "a year worldwide",
          "label": "items[1].steps[1][0].cue",
          "scene_time_s": 13.74,
          "absolute_s": 388.57
        },
        {
          "param": "items[2].at.cue",
          "cue": "fifteen to twenty percent",
          "label": "items[2].at.cue",
          "scene_time_s": 16.8,
          "absolute_s": 391.64
        },
        {
          "param": "cam[1].at.cue",
          "cue": "And according to its annual report",
          "label": "cam[1].at.cue",
          "scene_time_s": 21.05,
          "absolute_s": 395.88
        },
        {
          "param": "items[3].at.cue",
          "cue": "generally earn Costco higher",
          "label": "items[3].at.cue",
          "scene_time_s": 24.24,
          "absolute_s": 399.08
        }
      ],
      "unresolved_cues": [],
      "assets": [
