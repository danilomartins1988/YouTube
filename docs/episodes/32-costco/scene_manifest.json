      "id": "s21_volume",
      "segment": "m3_volume",
      "type": "engine_cartoon",
      "start_s": 357.3,
      "end_s": 374.83,
      "duration_s": 17.53,
      "visual_objective": "",
      "narration": "That short list is the trick. With nine hundred and thirty-nine warehouses around the world, every product on the shelf sells in enormous volume. And enormous volume gives Costco enormous bargaining power with the companies that make the goods.",
      "keyframes": [
        {
          "param": "items[3].at.cue",
          "cue": "warehouses around the world",
          "label": "items[3].at.cue",
          "scene_time_s": 4.06,
          "absolute_s": 361.36
        },
        {
          "param": "cam[1].at.cue",
          "cue": "enormous bargaining power",
          "label": "cam[1].at.cue",
          "scene_time_s": 13.09,
          "absolute_s": 370.39
        },
        {
          "param": "items[4].at.cue",
          "cue": "enormous bargaining power",
          "label": "items[4].at.cue",
          "scene_time_s": 13.09,
          "absolute_s": 370.39
        }
      ],
      "unresolved_cues": [],
      "assets": [
