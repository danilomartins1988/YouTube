      "type": "engine_cartoon",
      "start_s": 117.0,
      "end_s": 145.23,
      "duration_s": 28.23,
      "visual_objective": "",
      "narration": "And that thin slice still has to pay for everything else. The warehouses, the workers, the trucks, the electricity. After all of that, by our calculation, Costco's operating profit was less than four cents on every dollar of revenue. Its net income for the year was nine point two billion dollars. A big number, until you set it against nearly three hundred billion dollars of sales.",
      "keyframes": [
        {
          "param": "items[1].at.cue",
          "cue": "The warehouses",
          "label": "items[1].at.cue",
          "scene_time_s": 4.88,
          "absolute_s": 121.88
        },
        {
          "param": "items[2].at.cue",
          "cue": "by our calculation",
          "label": "items[2].at.cue",
          "scene_time_s": 10.94,
          "absolute_s": 127.94
        },
        {
          "param": "items[2].steps[1][0].cue",
          "cue": "less than four cents",
          "label": "items[2].steps[1][0].cue",
          "scene_time_s": 14.45,
          "absolute_s": 131.44
        },
        {
          "param": "cam[1].at.cue",
          "cue": "Its net income",
          "label": "cam[1].at.cue",
          "scene_time_s": 18.17,
          "absolute_s": 135.17
        },
        {
          "param": "items[3].at.cue",
          "cue": "Its net income",
          "label": "items[3].at.cue",
          "scene_time_s": 18.17,
          "absolute_s": 135.17
        }
      ],
