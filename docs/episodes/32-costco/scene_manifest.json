      ],
      "transition_out": "scan"
    },
    {
      "index": 25,
      "id": "s24_t3",
      "segment": "m3_transition",
      "type": "kinetic_text",
      "start_s": 423.73,
      "end_s": 435.17,
      "duration_s": 11.43,
      "visual_objective": "Kinetic typography: lines enter word by word on narration cues",
      "narration": "And the speed at which those products sell unlocks the most hidden part of the business. Costco often gets paid before it pays.",
      "keyframes": [
        {
