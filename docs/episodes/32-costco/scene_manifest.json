    {
      "index": 27,
      "id": "s26_quote",
      "segment": "m4_quote",
      "type": "engine_cartoon",
      "start_s": 440.57,
      "end_s": 464.17,
      "duration_s": 23.6,
      "visual_objective": "",
      "narration": "This is Costco, in its own annual report. We often sell inventory before we are required to pay for it, even while taking advantage of early payment discounts. Read that again. Costco can pay its suppliers early, collect a discount for doing it, and still have sold the goods to you before the money leaves its account.",
      "keyframes": [
        {
          "param": "items[3].at.cue",
          "cue": "while taking advantage",
          "label": "items[3].at.cue",
          "scene_time_s": 9.79,
