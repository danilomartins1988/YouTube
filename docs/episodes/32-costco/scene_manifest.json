      "type": "engine_cartoon",
      "start_s": 337.77,
      "end_s": 357.3,
      "duration_s": 19.53,
      "visual_objective": "",
      "narration": "Walk into any Costco and the design tells the same story. Concrete floors, tall steel shelves, goods still on their shipping pallets. No fancy displays, no decoration. Every dollar not spent on the store is a dollar that can come off the price.",
      "keyframes": [
        {
          "param": "items[2].at.cue",
          "cue": "Concrete floors",
