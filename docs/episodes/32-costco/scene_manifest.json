    },
    {
      "index": 2,
      "id": "s02_twist",
      "segment": "h_twist",
      "type": "engine_cartoon",
      "start_s": 12.1,
      "end_s": 29.73,
      "duration_s": 17.63,
      "visual_objective": "",
      "narration": "Now compare it with Costco's operating profit for the same year, eleven point seven billion dollars. By our calculation, the membership fees alone equal about half of it. On the goods it sells, Costco barely makes any money at all.",
