          "cue": "equal about half",
          "label": "items[1].at.cue",
          "scene_time_s": 10.83,
          "absolute_s": 22.93
        },
        {
          "param": "items[2].at.cue",
          "cue": "equal about half",
          "label": "items[2].at.cue",
          "scene_time_s": 11.23,
          "absolute_s": 23.33
