          "scene_time_s": 8.2,
          "absolute_s": 410.3
        },
        {
          "param": "actions[0].at.cue",
          "cue": "far fewer items",
          "label": "actions[0].at.cue",
          "scene_time_s": 15.9,
          "absolute_s": 418.0
        },
        {
          "param": "strokes[3].start.cue",
          "cue": "squeeze the price",
          "label": "strokes[3].start.cue",
          "scene_time_s": 19.29,
          "absolute_s": 421.39
        }
      ],
      "unresolved_cues": [],
      "assets": [
