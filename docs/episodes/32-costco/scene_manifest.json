    {
      "index": 13,
      "id": "s12_members",
      "segment": "m2_members",
      "type": "engine_cartoon",
      "start_s": 187.07,
      "end_s": 202.47,
      "duration_s": 15.4,
      "visual_objective": "",
      "narration": "To shop at Costco, you need a membership. At the end of its last financial year, Costco had about eighty-four million paid members, and about one hundred and fifty million cardholders once family and business cards are counted.",
      "keyframes": [
        {
          "param": "items[10].steps[1][0].cue",
          "cue": "paid members",
          "label": "items[10].steps[1][0].cue",
          "scene_time_s": 8.33,
          "absolute_s": 195.4
        },
        {
          "param": "cam[1].at.cue",
          "cue": "cardholders",
          "label": "cam[1].at.cue",
          "scene_time_s": 11.6,
          "absolute_s": 198.67
        },
        {
          "param": "items[11].at.cue",
          "cue": "cardholders",
          "label": "items[11].at.cue",
          "scene_time_s": 11.6,
          "absolute_s": 198.67
        }
