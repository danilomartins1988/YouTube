    {
      "index": 18,
      "id": "s17_t2",
      "segment": "m2_transition",
      "type": "kinetic_text",
      "start_s": 309.57,
      "end_s": 317.8,
      "duration_s": 8.23,
      "visual_objective": "Kinetic typography: lines enter word by word on narration cues",
      "narration": "But low prices do not come from fees alone. They also come from what Costco refuses to sell.",
      "keyframes": [
        {
          "param": "lines[0].cue",
          "cue": "But low prices",
          "label": "Low prices need more than fees",
          "scene_time_s": 0.35,
