          "scene_time_s": 11.15,
          "absolute_s": 418.18
        },
        {
          "param": "strokes[3].start.cue",
          "cue": "Every dollar",
          "label": "strokes[3].start.cue",
          "scene_time_s": 15.27,
          "absolute_s": 422.3
        },
        {
          "param": "actions[0].at.cue",
          "cue": "cannot go to the other",
          "label": "actions[0].at.cue",
          "scene_time_s": 17.6,
          "absolute_s": 424.64
        }
      ],
      "unresolved_cues": [],
