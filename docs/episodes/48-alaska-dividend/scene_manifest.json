      ],
      "transition_out": "scan"
    },
    {
      "index": 33,
      "id": "s32_t4",
      "segment": "m4_transition",
      "type": "kinetic_text",
      "start_s": 528.43,
      "end_s": 537.47,
      "duration_s": 9.03,
      "visual_objective": "Kinetic typography: lines enter word by word on narration cues",
      "narration": "So what does a yearly check actually do to the people who get it? Economists have studied that question for years.",
      "keyframes": [
        {
          "param": "lines[0].cue",
          "cue": "So what does",
          "label": "What does a yearly check do?",
          "scene_time_s": 0.35,
          "absolute_s": 528.78
        },
        {
          "param": "lines[1].cue",
          "cue": "studied that question",
          "label": "…economists have studied it",
          "scene_time_s": 6.65,
          "absolute_s": 535.09
        }
      ],
      "unresolved_cues": [],
      "assets": [
        "font:inter"
      ],
      "sources": [],
      "transition_out": "scan"
    },
    {
      "index": 34,
      "id": "s33_c5",
      "segment": "m5_card",
      "type": "act_title",
      "start_s": 537.47,
      "end_s": 542.87,
      "duration_s": 5.4,
      "visual_objective": "Chapter card: masked title reveal, gold rule draws",
      "narration": "",
      "keyframes": [],
      "unresolved_cues": [],
      "assets": [
        "font:inter"
      ],
      "sources": [],
      "transition_out": "scan"
    },
    {
      "index": 35,
      "id": "s34_jobs",
      "segment": "m5_jobs",
      "type": "engine_cartoon",
      "start_s": 542.87,
      "end_s": 567.4,
      "duration_s": 24.53,
      "visual_objective": "",
      "narration": "The big fear about free money is that people stop working. Economists Damon Jones and Ioana Marinescu tested that in Alaska. They found no effect on employment. Part-time work actually rose a little, by about one point eight percentage points. Their study was published in a peer-reviewed economics journal in twenty twenty-two.",
      "keyframes": [
        {
          "param": "items[1].at.cue",
          "cue": "They found no effect",
          "label": "items[1].at.cue",
          "scene_time_s": 10.84,
          "absolute_s": 553.71
        },
        {
          "param": "cam[1].at.cue",
          "cue": "Part-time work",
          "label": "cam[1].at.cue",
          "scene_time_s": 13.45,
          "absolute_s": 556.32
        },
        {
          "param": "items[2].at.cue",
          "cue": "Part-time work",
          "label": "items[2].at.cue",
          "scene_time_s": 13.45,
          "absolute_s": 556.32
        }
      ],
      "unresolved_cues": [],
      "assets": [
        "font:inter"
      ],
      "sources": [
        "research"
      ],
      "transition_out": "scan"
    },
    {
      "index": 36,
      "id": "s35_spend",
      "segment": "m5_spend",
      "type": "engine_cartoon",
      "start_s": 567.4,
      "end_s": 598.13,
      "duration_s": 30.73,
      "visual_objective": "",
      "narration": "People do spend it. Another study found that households spend about a quarter of the payment on everyday goods and services within three months. Researchers have also linked an extra thousand dollars to slightly higher birth weights. And one study of crime found a jump in substance-abuse incidents the day after the checks arrive, about fourteen percent, while property crime fell about eight percent, and violent crime did not change.",
      "keyframes": [
        {
          "param": "items[1].at.cue",
          "cue": "about a quarter",
          "label": "items[1].at.cue",
          "scene_time_s": 5.09,
          "absolute_s": 572.49
        },
        {
          "param": "items[2].at.cue",
          "cue": "birth weights",
          "label": "items[2].at.cue",
          "scene_time_s": 15.64,
          "absolute_s": 583.04
        },
        {
          "param": "cam[1].at.cue",
          "cue": "one study of crime",
          "label": "cam[1].at.cue",
          "scene_time_s": 17.14,
          "absolute_s": 584.54
        },
        {
          "param": "items[3].at.cue",
          "cue": "one study of crime",
          "label": "items[3].at.cue",
          "scene_time_s": 17.14,
          "absolute_s": 584.54
        }
      ],
      "unresolved_cues": [],
      "assets": [
        "font:inter"
      ],
      "sources": [
        "research"
      ],
      "transition_out": "scan"
    },
    {
      "index": 37,
      "id": "p36_arrows",
      "segment": "m5_draw",
      "type": "engine_draw",
      "start_s": 598.13,
      "end_s": 621.4,
      "duration_s": 23.27,
      "visual_objective": "",
      "narration": "Let me draw what the research says. Here is the check arriving. One arrow, to jobs, with almost no change. One arrow, to spending, about a quarter within a few months. And a few small arrows, to health and safety. A cash payment that people use, without walking away from work.",
      "keyframes": [
        {
          "param": "draw_start.cue",
          "cue": "Here is the check arriving",
          "label": "draw_start.cue",
          "scene_time_s": 3.22,
          "absolute_s": 601.35
        },
        {
          "param": "strokes[0].start.cue",
          "cue": "Here is the check arriving",
          "label": "strokes[0].start.cue",
          "scene_time_s": 3.22,
          "absolute_s": 601.35
        },
        {
          "param": "strokes[1].start.cue",
          "cue": "to jobs",
          "label": "strokes[1].start.cue",
          "scene_time_s": 6.7,
          "absolute_s": 604.83
        },
        {
          "param": "strokes[2].start.cue",
          "cue": "to spending",
          "label": "strokes[2].start.cue",
          "scene_time_s": 10.61,
          "absolute_s": 608.74
        },
        {
          "param": "strokes[3].start.cue",
          "cue": "a few small arrows",
          "label": "strokes[3].start.cue",
          "scene_time_s": 14.74,
          "absolute_s": 612.88
        },
        {
