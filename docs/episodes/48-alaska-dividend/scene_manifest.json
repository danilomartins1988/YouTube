          "scene_time_s": 9.09,
          "absolute_s": 45.85
        },
        {
          "param": "items[2].at.cue",
          "cue": "what economists found",
          "label": "items[2].at.cue",
          "scene_time_s": 11.58,
          "absolute_s": 48.35
        }
      ],
      "unresolved_cues": [],
      "assets": [
        "font:inter"
      ],
      "sources": [],
      "transition_out": "scan"
    },
    {
      "index": 5,
      "id": "s05_c1",
