      "type": "engine_cartoon",
      "start_s": 437.73,
      "end_s": 450.97,
      "duration_s": 13.23,
      "visual_objective": "",
      "narration": "The governor's budget proposed a full dividend under the old formula, about three thousand six hundred and fifty dollars per Alaskan. The legislature chose something much smaller.",
      "keyframes": [
        {
          "param": "items[1].at.cue",
          "cue": "proposed a full dividend",
          "label": "items[1].at.cue",
          "scene_time_s": 1.68,
          "absolute_s": 439.42
        },
        {
          "param": "items[0].stampAt.cue",
          "cue": "about three thousand",
          "label": "items[0].stampAt.cue",
          "scene_time_s": 5.22,
          "absolute_s": 442.95
        },
        {
          "param": "cam[1].at.cue",
          "cue": "The legislature chose",
          "label": "cam[1].at.cue",
          "scene_time_s": 9.81,
          "absolute_s": 447.54
        },
        {
          "param": "items[2].at.cue",
