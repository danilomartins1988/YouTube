    {
      "index": 19,
      "id": "s18_t2",
      "segment": "m2_transition",
      "type": "kinetic_text",
      "start_s": 310.5,
      "end_s": 317.1,
      "duration_s": 6.6,
      "visual_objective": "Kinetic typography: lines enter word by word on narration cues",
      "narration": "For years, the dividend had its own formula. Then the state ran short of money.",
