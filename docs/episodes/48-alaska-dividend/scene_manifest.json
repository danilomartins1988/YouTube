      "transition_out": "scan"
    },
    {
      "index": 26,
      "id": "s25_t3",
      "segment": "m3_transition",
      "type": "kinetic_text",
      "start_s": 426.6,
      "end_s": 432.33,
      "duration_s": 5.73,
      "visual_objective": "Kinetic typography: lines enter word by word on narration cues",
      "narration": "Which is exactly the fight that played out again in twenty twenty-six.",
      "keyframes": [
