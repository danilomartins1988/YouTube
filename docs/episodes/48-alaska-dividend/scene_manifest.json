      "end_s": 16.57,
      "duration_s": 16.57,
      "visual_objective": "",
      "narration": "Twelve hundred dollars. That is what the state of Alaska paid to almost every resident in twenty twenty-six. Men, women, children, even babies. No work required. Just live there for the whole year.",
      "keyframes": [
        {
          "param": "items[1].at.cue",
          "cue": "Men,",
          "label": "items[1].at.cue",
          "scene_time_s": 8.39,
          "absolute_s": 8.39
        },
        {
          "param": "items[2].at.cue",
          "cue": "Men,",
          "label": "items[2].at.cue",
          "scene_time_s": 8.39,
          "absolute_s": 8.39
        },
        {
          "param": "items[3].at.cue",
          "cue": "Men,",
          "label": "items[3].at.cue",
          "scene_time_s": 8.39,
          "absolute_s": 8.39
        }
      ],
      "unresolved_cues": [],
      "assets": [
        "font:inter"
