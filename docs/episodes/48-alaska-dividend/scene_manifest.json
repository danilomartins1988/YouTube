    {
      "index": 21,
      "id": "s20_veto",
      "segment": "m3_veto",
      "type": "engine_cartoon",
      "start_s": 322.5,
      "end_s": 339.9,
      "duration_s": 17.4,
      "visual_objective": "",
      "narration": "In twenty sixteen, oil prices had collapsed and the state budget was in deep trouble. The governor at the time, Bill Walker, cut the money set aside for the dividend roughly in half. The check that year was one thousand and twenty-two dollars.",
      "keyframes": [
        {
          "param": "items[1].at.cue",
          "cue": "cut the money",
          "label": "items[1].at.cue",
          "scene_time_s": 9.23,
          "absolute_s": 331.73
        },
        {
          "param": "cam[1].at.cue",
          "cue": "The check",
          "label": "cam[1].at.cue",
          "scene_time_s": 13.46,
          "absolute_s": 335.96
        },
        {
          "param": "items[2].at.cue",
          "cue": "The check",
          "label": "items[2].at.cue",
          "scene_time_s": 13.46,
          "absolute_s": 335.96
        }
