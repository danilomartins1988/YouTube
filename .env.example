# Copy to .env and fill in only what you use. Never commit .env.
# Every paid provider is OFF unless its key is set AND it is selected in config/settings.yaml
# (or via --tts). Nothing is purchased automatically.

# --- Text-to-speech (optional, paid) ---
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Piper (free, local neural TTS) ---
# Path to a downloaded Piper voice (.onnx with matching .onnx.json next to it)
PIPER_VOICE_PATH=models/piper/en_GB-alan-medium.onnx

# --- Research data ---
# World Bank API needs no key. Set to 1 to skip network and use committed snapshots only.
HIDDENECO_OFFLINE=0

# --- Logging ---
HIDDENECO_LOG_LEVEL=INFO

# --- Kokoro (free, local, natural neural TTS; Apache-2.0) ---
# Download kokoro-v1.0.onnx and voices-v1.0.bin (see README) and point to them:
KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin
